{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "test_bringup: Configure Debug",
            "type": "process",
            "command": "${env:STM32CLT_PATH}/CMake/bin/cmake.exe",
            "args": ["--preset", "Debug"],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${env:STM32CLT_PATH}/GNU-tools-for-STM32/bin;${env:STM32CLT_PATH}/Ninja/bin;${env:PATH}"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "test_bringup: Build Debug",
            "type": "process",
            "command": "${env:STM32CLT_PATH}/CMake/bin/cmake.exe",
            "args": ["--build", "--preset", "Debug", "--parallel"],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${env:STM32CLT_PATH}/GNU-tools-for-STM32/bin;${env:STM32CLT_PATH}/Ninja/bin;${env:PATH}"
                }
            },
            "dependsOn": "test_bringup: Configure Debug",
            "dependsOrder": "sequence",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        }
    ]
}

